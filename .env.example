# ==========================================
# 作文副驾驶 - 环境变量模板
# ==========================================
# 复制此文件为 .env.local 并填入你的 key
#   cp .env.example .env.local
# ==========================================

# 必填：OpenRouter API Key
# 申请地址：https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# 可选：默认模型（不填走 fallback chain：Kimi K2 → DeepSeek V3 → Qwen → ...）
# 国区账户推荐用：moonshotai/kimi-k2 (中文写作最佳) / deepseek/deepseek-chat (速度最快)
# OPENROUTER_MODEL=moonshotai/kimi-k2

# 可选：是否开启 bundle analyzer（npm run analyze）
# ANALYZE=true

# ==========================================
# 部署相关（一般不用改）
# ==========================================
# 端口（默认 3000）
# PORT=3000
# 主机（默认 0.0.0.0）
# HOST=0.0.0.0
